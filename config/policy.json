{
  "schema_version": "1.0",
  "architecture": "GPT_APP_BOARD_FIRST_V1",
  "execution": {
    "surface": "CHATGPT_WORK_OR_CHAT",
    "additional_paid_budget_krw": 0,
    "paid_api_allowed": false,
    "paid_saas_allowed": false,
    "ask_user_for_routine_approval": false,
    "terminal_states": [
      "DONE",
      "ABANDONED_BY_USER"
    ],
    "retryable_states": [
      "WAITING_INCLUDED_IMAGE_CAPACITY",
      "WAITING_TOOL_RECOVERY",
      "WAITING_REQUIRED_BYTES",
      "WAITING_PERMISSION_RECOVERY"
    ]
  },
  "product": {
    "aspect_ratio": "4:5",
    "width": 1080,
    "height": 1350,
    "delivery": "ONE_FILE_PER_SLIDE",
    "text_free_art_master": true
  },
  "render": {
    "default_lane": "MASTER_BOARD",
    "board_rows": 2,
    "board_columns": 2,
    "maximum_slides_per_board": 4,
    "board_is_internal_only": true,
    "actual_reference_media_required": true,
    "text_in_master_board_forbidden": true,
    "full_slide_generation_from_scratch_forbidden_when_board_exists": true,
    "whole_board_retry_limit": 1,
    "single_slide_repair_limit": 2
  },
  "source": {
    "human_seed_required": true,
    "traceable_url_required": true,
    "verbatim_quote_limit_words": 20,
    "fictionalization_must_be_labeled": true
  },
  "visual_qc": {
    "actual_pixels_required": true,
    "fixed_camera_direction_quota_forbidden": true,
    "reject_generic_ai_polish": true,
    "reject_identity_drift": true,
    "reject_anatomy_or_contact_failure": true,
    "reject_impossible_screen_geometry": true,
    "reject_baked_dialogue_in_art": true,
    "sequence_redundancy_review_required": true,
    "meaning_fidelity_review_required": true,
    "rejected_inputs_quarantined": true
  },
  "stages": [
    "BOOTSTRAP",
    "SOURCE_LOCK",
    "STORY_LOCK",
    "STORYBOARD_LOCK",
    "VISUAL_PACKET_LOCK",
    "BOARD_DISPATCH_READY",
    "MASTER_BOARD_IMPORTED",
    "MASTER_BOARD_QC",
    "SLIDES_EXPANDED",
    "ART_SEQUENCE_QC",
    "LETTERING_COMPLETE",
    "FINAL_QC",
    "EXPORT_READY",
    "DONE"
  ],
  "references": {
    "production_registry": "references/registry.json",
    "user_designation_is_sufficient_provenance": true,
    "independent_authorship_verification_required": false,
    "generated_artifact_can_be_primary_style": false,
    "approved_generated_artifact_default_scope": "EPISODE_LOCAL",
    "continuity_anchor_promotion_requires": [
      "EXPLICIT_USER_VISUAL_APPROVAL",
      "OBJECTIVE_QC_PASS",
      "NONREDUNDANT_CONTINUITY_VALUE"
    ],
    "continuity_anchor_never_overrides_primary_style": true,
    "prefer_minimum_sufficient_reference_set": true,
    "repo_bytes_must_be_retrieved_before_waiting_required_bytes": true,
    "episode_local_identity_requires_dedicated_reference": false,
    "request_new_user_upload_when_registry_coverage_sufficient": false,
    "registered_reference_bytes_must_be_retrieved_without_reupload": true,
    "user_attachment_transport_fallback_allowed": true,
    "user_attachment_transport_fallback_only_after_runtime_bridge_failure": true,
    "user_attachment_transport_does_not_create_new_reference": true
  },
  "runtime_attachment": {
    "preflight_required_before_image_dispatch": true,
    "revalidate_after_session_or_surface_change": true,
    "persistent_authority": "REPOSITORY_REGISTRY_SHA256",
    "carrier_scope": "SESSION_ONLY",
    "preferred_carrier": "REPOSITORY_DIRECT",
    "fallback_carriers": [
      "CURRENT_SESSION_ATTACHMENT",
      "WORK_RUNTIME_FILE"
    ],
    "user_attachment_transport_fallback_allowed": true,
    "fallback_only_after_direct_runtime_bridge_unavailable": true,
    "attachment_does_not_reset_episode_or_stage": true,
    "opaque_runtime_handle_is_reference_authority": false,
    "file_uri_alone_proves_image_binding": false
  },
  "execution_modes": {
    "chat": {
      "strategy": "BOUNDED_AUTONOMOUS_MULTI_TURN",
      "routine_approval_required": false,
      "continuation_token": "계속",
      "continuation_token_is_approval": false,
      "durable_turn_boundaries": [
        "BOARD_DISPATCH_READY",
        "ART_SEQUENCE_QC",
        "DONE"
      ],
      "boundary_checkpoint_required": true,
      "response_boundary_is_state_machine_stage": false,
      "quality_gates_may_be_skipped_for_turn_budget": false
    },
    "work": {
      "strategy": "ONE_SHOT_TO_DONE_OR_RETRYABLE_BLOCK",
      "routine_approval_required": false,
      "intentional_turn_boundaries": false,
      "stage_checkpoint_required": true,
      "quality_gates_may_be_skipped_for_execution_budget": false
    },
    "common": {
      "same_production_state_machine": true,
      "repository_state_is_cross_turn_authority": true,
      "canonical_boot_from_latest_main_each_turn": true,
      "conversational_summary_is_handoff_authority": false,
      "load_only_exact_next_action_companions_after_boot": true
    }
  }
}
