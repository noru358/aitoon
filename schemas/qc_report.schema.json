{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToon visual QC report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "episode_id", "scope", "inspected",
    "hard_checks", "visual_checks", "status", "repair_owner", "repair_scope"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "report_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
    "scope": {"enum": ["MASTER_BOARD", "SLIDE", "ART_SEQUENCE", "FINAL_SEQUENCE"]},
    "inspected": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "hard_checks": {"type": "array", "items": {"type": "object"}},
    "visual_checks": {"type": "array", "items": {"type": "object"}},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED_UNSEEN"]},
    "repair_owner": {"type": ["string", "null"]},
    "repair_scope": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}

