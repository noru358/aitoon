{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToon master board plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "episode_id", "board_id", "rows", "columns",
    "outer_margin_px", "gutter_px", "cells"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "episode_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
    "board_id": {"type": "string", "pattern": "^B[0-9]{2,}$"},
    "rows": {"const": 2},
    "columns": {"const": 2},
    "outer_margin_px": {"type": "integer", "minimum": 0},
    "gutter_px": {"type": "integer", "minimum": 0},
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slide_id", "row", "column", "intent"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "row": {"type": "integer", "minimum": 0, "maximum": 1},
          "column": {"type": "integer", "minimum": 0, "maximum": 1},
          "intent": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

