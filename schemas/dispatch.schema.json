{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToon ChatGPT image dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dispatch_id", "episode_id", "target_id", "operation",
    "prompt", "bound_media", "attempt", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dispatch_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "pattern": "^E[0-9]{3,}$"},
    "target_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["GENERATE_MASTER_BOARD", "EXPAND_SLIDE", "REPAIR_SLIDE", "ADD_LETTERING"]},
    "prompt": {"type": "string", "minLength": 1},
    "bound_media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_or_handle", "sha256", "role"],
        "properties": {
          "path_or_handle": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"]},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["READY", "DISPATCHED", "IMPORTED", "REJECTED", "APPROVED", "WAITING_RETRY"]}
  }
}

