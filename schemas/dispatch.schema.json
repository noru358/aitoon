{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToon ChatGPT image dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "episode_id",
    "target_id",
    "operation",
    "prompt",
    "bound_media",
    "attempt",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "pattern": "^E[0-9]{3,}$"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "GENERATE_MASTER_BOARD",
        "EXPAND_SLIDE",
        "REPAIR_SLIDE",
        "ADD_LETTERING"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "bound_media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path_or_handle",
          "sha256",
          "role"
        ],
        "properties": {
          "path_or_handle": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "READY",
        "DISPATCHED",
        "IMPORTED",
        "REJECTED",
        "APPROVED",
        "WAITING_RETRY",
        "SUPERSEDED"
      ]
    },
    "runtime_attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_required_before_execute",
        "source_authority",
        "carrier_scope",
        "preferred_carrier",
        "fallback_carriers",
        "fallback_only_after_direct_runtime_bridge_unavailable",
        "revalidate_after_session_or_surface_change",
        "attachment_does_not_reset_episode_or_stage",
        "opaque_runtime_handle_is_reference_authority",
        "required_sha_carriers"
      ],
      "properties": {
        "preflight_required_before_execute": {
          "const": true
        },
        "source_authority": {
          "enum": [
            "REPOSITORY_REGISTRY_SHA256",
            "REPOSITORY_MANIFEST_AND_SHA256"
          ]
        },
        "carrier_scope": {
          "const": "SESSION_ONLY"
        },
        "preferred_carrier": {
          "const": "REPOSITORY_DIRECT"
        },
        "fallback_carriers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CURRENT_SESSION_ATTACHMENT",
              "WORK_RUNTIME_FILE"
            ]
          }
        },
        "fallback_only_after_direct_runtime_bridge_unavailable": {
          "const": true
        },
        "revalidate_after_session_or_surface_change": {
          "const": true
        },
        "attachment_does_not_reset_episode_or_stage": {
          "const": true
        },
        "opaque_runtime_handle_is_reference_authority": {
          "const": false
        },
        "required_sha_carriers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "anchor_id",
              "sha256",
              "role",
              "allowed_influence",
              "forbidden_inference"
            ],
            "properties": {
              "anchor_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "allowed_influence": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_inference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "eligible_for_execution": {
      "type": "boolean"
    },
    "superseded_reason": {
      "type": "string"
    },
    "runtime_sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "rows",
        "columns",
        "cell_count",
        "cells",
        "generator_empty_cells_forbidden",
        "pack_to_canonical_2x2"
      ],
      "properties": {
        "strategy": {
          "const": "NATURAL_OCCUPANCY"
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "cell_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slide_id",
              "runtime_row",
              "runtime_column",
              "canonical_row",
              "canonical_column"
            ],
            "properties": {
              "slide_id": {
                "type": "string",
                "pattern": "^S[0-9]{2,}$"
              },
              "runtime_row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "runtime_column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "canonical_row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "canonical_column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "generator_empty_cells_forbidden": {
          "const": true
        },
        "pack_to_canonical_2x2": {
          "const": true
        }
      }
    },
    "context_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "art_only",
        "allowed",
        "forbidden"
      ],
      "properties": {
        "art_only": {
          "const": true
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "approved_visual_anchor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_id",
            "sha256",
            "allowed_influence",
            "forbidden_inference",
            "transport"
          ],
          "properties": {
            "anchor_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allowed_influence": {
              "type": "string",
              "minLength": 1
            },
            "forbidden_inference": {
              "type": "string",
              "minLength": 1
            },
            "transport": {
              "enum": [
                "REPOSITORY",
                "SESSION_CARRIER_REQUIRED"
              ]
            }
          }
        }
      ]
    }
  }
}
