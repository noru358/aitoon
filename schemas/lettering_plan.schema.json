{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIToon editable lettering plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slide_id", "base_art", "canvas", "font", "elements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "slide_id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
    "base_art": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"const": 1080},
        "height": {"const": 1350}
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "role", "text", "box", "align", "font_size", "fill", "bubble"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["CAPTION", "SPEECH", "THOUGHT", "SFX", "UI"]},
          "text": {"type": "string"},
          "box": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            }
          },
          "align": {"enum": ["left", "center", "right"]},
          "font_size": {"type": "integer", "minimum": 12, "maximum": 200},
          "fill": {"type": "string"},
          "bubble": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["fill", "outline", "outline_width", "radius", "padding", "tail_tip"],
                "properties": {
                  "fill": {"type": "string"},
                  "outline": {"type": "string"},
                  "outline_width": {"type": "integer", "minimum": 0},
                  "radius": {"type": "integer", "minimum": 0},
                  "padding": {"type": "integer", "minimum": 0},
                  "tail_tip": {
                    "anyOf": [
                      {"type": "null"},
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["x", "y"],
                        "properties": {
                          "x": {"type": "integer"},
                          "y": {"type": "integer"}
                        }
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}

